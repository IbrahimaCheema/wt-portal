---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';

const galleryVideos = [
  {
    id: 'vid1',
    title: 'Spinning Mill Machinery Tour (Intercot Spain)',
    src: getMediaUrl('/videos/gallery_vid1.mp4'),
    poster: getMediaUrl('/images/gallery/spain_1.jpg'),
    desc: 'Executive walkthrough inspecting automated spinning machinery and yarn cones at Intercot Mill facility in Barcelona, Spain.'
  },
  {
    id: 'vid2',
    title: 'Intercot Showroom & Yarn Samples Display',
    src: getMediaUrl('/videos/gallery_vid2.mp4'),
    poster: getMediaUrl('/images/gallery/spain_3.jpg'),
    desc: 'Showroom collection tour showcasing organic cotton yarns, eco-friendly blended samples, and decorative fabric displays.'
  },
  {
    id: 'vid3',
    title: 'High-Speed Textile Spinning Machinery in Operation',
    src: getMediaUrl('/videos/gallery_vid3.mp4'),
    poster: getMediaUrl('/images/gallery/spain_5.jpg'),
    desc: 'Live operational recording of high-speed Autocoro B spinning frames and quality monitoring systems.'
  },
  {
    id: 'ceo-interview-vid',
    title: 'Executive Interview: CEO Mr. Hasan Shahid by Ms. Alex Diaz',
    src: getMediaUrl('/videos/ceo_interview.mp4'),
    poster: getMediaUrl('/images/news_interview.png'),
    desc: 'Global white paper interview discussing international sourcing strategy, contract integrity, and strategic mill partnerships.'
  }
];

const galleryAlbums = [
  {
    id: 'ht2025',
    title: 'Dinner meeting post Heimtextil Frankfurt 2025',
    category: 'Heimtextil 2025',
    items: [
      { src: '/images/gallery/ht2025_1.jpg', title: 'Heimtextil 2025 Dinner Discussion' },
      { src: '/images/gallery/ht2025_2.jpg', title: 'Heimtextil 2025 Executive Group' }
    ]
  },
  {
    id: 'ic2025',
    title: 'Intercot Visit 2025',
    category: 'Intercot 2025',
    items: [
      { src: '/images/gallery/ic2025_1.jpg', title: 'Intercot Mill Executive Tour 2025' },
      { src: '/images/gallery/ic2025_2.jpg', title: 'Intercot Technical Meeting 2025' }
    ]
  },
  {
    id: 'ht2024',
    title: 'Heimtextil and Intercot Visit 2024',
    category: 'Heimtextil 2024',
    items: [
      { src: '/images/gallery/ht2024_1.jpg', title: 'Heimtextil 2024 Booth Engagement' },
      { src: '/images/gallery/ht2024_2.jpg', title: 'Delegation Meeting in Frankfurt' },
      { src: '/images/gallery/ht2024_3.jpg', title: 'Meeting with European Buyers' },
      { src: '/images/gallery/ht2024_4.jpg', title: 'Intercot Barcelona Visit 2024' },
      { src: '/images/gallery/ht2024_5.jpg', title: 'Corporate Alliance Discussion' },
      { src: '/images/gallery/ht2024_6.jpg', title: 'Textile Sourcing Delegation' }
    ]
  },
  {
    id: 'fazal-artistic',
    title: 'Visit to Fazal Cloth Mills with Artistic Milliners Team',
    category: 'Mill Visits',
    items: [
      { src: '/images/gallery/fazal_1.jpg', title: 'Fazal Cloth Mills Spinning Division' },
      { src: '/images/gallery/fazal_2.jpg', title: 'Artistic Milliners Team Joint Inspection' },
      { src: '/images/gallery/fazal_3.jpg', title: 'Yarn Quality Testing & Review' },
      { src: '/images/gallery/fazal_4.jpg', title: 'Manufacturing Facility Tour' },
      { src: '/images/gallery/fazal_5.jpg', title: 'Executive Group Photo' },
      { src: '/images/gallery/fazal_6.jpg', title: 'Technical Discussion on Ring Spun Yarns' }
    ]
  },
  {
    id: 'spain-visit',
    title: 'Western Group’s Visit to Intercot Spain',
    category: 'Spain Visit',
    items: [
      { src: '/images/gallery/spain_1.jpg', title: 'Executive Meeting Room - Director Mr. Ramon & CEO Mr. Hasan Shahid' },
      { src: '/images/gallery/spain_2.jpg', title: 'Intercot Corporate Entrance & Spinning Machinery Banner' },
      { src: '/images/gallery/spain_3.jpg', title: 'Office Sample Display & Historical Mill Photography' },
      { src: '/images/gallery/spain_4.jpg', title: '#1 Mundial Flax & Organic Linen Fiber Showcase' },
      { src: '/images/gallery/spain_5.jpg', title: 'Raw Cotton Bales & Automated Bale Opener' },
      { src: '/images/gallery/spain_6.jpg', title: 'Recycled Fiber Grade Tube Inspection' },
      { src: '/images/gallery/spain_7.jpg', title: 'Hand Quality Inspection of Blended Fiber Twist' },
      { src: '/images/gallery/spain_8.jpg', title: 'Raw Linen Fiber Sample Hand Touch Quality Check' },
      { src: '/images/gallery/spain_9.jpg', title: 'Cotton Storage Warehouse & Bales Stack' },
      { src: '/images/gallery/spain_10.jpg', title: 'Shade Book & Color Swatch Catalog Collection' },
      { src: '/images/gallery/spain_11.jpg', title: 'Comprehensive Color Card Swatches & Melange Yarns' }
    ]
  },
  {
    id: 'qst-lanka-album',
    title: 'QST Lanka Visit to Pakistan',
    category: 'QST Partnership',
    items: [
      { src: '/images/gallery/qst_lanka_1.jpg', title: 'QST Lanka Delegation Welcome Session' },
      { src: '/images/gallery/qst_lanka_2.jpg', title: 'Technical Trim Conference with Manufacturers' },
      { src: '/images/gallery/qst_lanka_3.jpg', title: 'Ban-Roll & Pocketing Sample Review' },
      { src: '/images/gallery/qst_lanka_4.jpg', title: 'Executive Group Photo at Western Traders Office' }
    ]
  },
  {
    id: 'artistic-milliners-punjab',
    title: 'Artistic Milliners team’s visit to Punjab',
    category: 'Mill Visits',
    items: [
      { src: '/images/gallery/qst_del_1.jpg', title: 'Artistic Milliners Executive Mill Visit' },
      { src: '/images/gallery/qst_del_2.jpg', title: 'Quality Testing of Spinning Components' },
      { src: '/images/gallery/qst_del_3.jpg', title: 'Denim Yarn Technical Review' },
      { src: '/images/gallery/qst_del_4.jpg', title: 'Sourcing Delegation Discussion' },
      { src: '/images/gallery/qst_del_5.jpg', title: 'Corporate Partnership Session' }
    ]
  }
];
---

<Layout title="Photo & Video Gallery | Western Traders" activePage="gallery">
  <!-- Top Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>&rsaquo;</span> <span class="current">Gallery</span>
      </div>
      <h1 class="hero_page_title">Photo & Video Gallery</h1>
      <p class="hero_subtitle">
        Comprehensive visual archive featuring our trade fair delegations, spinning mill walk recordings, executive meetings, and photo collages across Germany, Spain, and Pakistan.
      </p>
    </div>
  </section>

  <!-- Video Gallery Section (All Embedded Videos) -->
  <section class="section-padding video-gallery-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">VIDEO ARCHIVE</span>
        <h2 class="section-title">Official Video Recordings</h2>
        <p class="section-subtitle">Walkthrough tours of Intercot spinning mills in Barcelona, showroom displays, and executive interviews.</p>
      </div>

      <div class="video-grid-2x2">
        {galleryVideos.map((vid) => (
          <div class="video-card card" id={vid.id}>
            <div class="video-container">
              <video
                controls
                preload="metadata"
                poster={vid.poster}
                class="responsive-video-player"
              >
                <source src={vid.src} type="video/mp4" />
                Your browser does not support HTML5 video playback.
              </video>
            </div>
            <div class="video-card-body">
              <span class="video-badge">VIDEO RECORDING</span>
              <h3 class="video-card-title">{vid.title}</h3>
              <p class="video-card-desc">{vid.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo Collages & Albums -->
  <section class="section-padding photo-gallery-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">EXHIBITION & DELEGATION ALBUMS</span>
        <h2 class="section-title">Corporate Photo Albums</h2>
        <p class="section-subtitle">High-resolution photo collages from trade fairs and mill visits across Frankfurt, Barcelona, Lahore, and Multan.</p>
      </div>

      <div class="albums-container">
        {galleryAlbums.map((album) => (
          <div class="album-block card" id={album.id}>
            <div class="album-header">
              <div>
                <span class="album-cat-tag">{album.category}</span>
                <h3 class="album-title">{album.title}</h3>
              </div>
              <span class="album-count-badge">{album.items.length} Photos</span>
            </div>

            <div class="photo-grid">
              {album.items.map((item) => (
                <div class="photo-card" data-full-src={getMediaUrl(item.src)} data-caption={item.title}>
                  <img
                    src={getMediaUrl(item.src)}
                    alt={item.title}
                    class="gallery-img"
                    loading="lazy"
                    onerror="this.onerror=null; this.src='/images/wt_header_logo.png'"
                  />
                  <div class="photo-overlay">
                    <span class="photo-zoom-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                    </span>
                    <span class="photo-caption-text">{item.title}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div id="gallery-lightbox" class="lightbox-modal">
    <span class="lightbox-close">&times;</span>
    <img id="lightbox-img" class="lightbox-content" src="" alt="Zoomed view" />
    <div id="lightbox-caption" class="lightbox-caption"></div>
  </div>

  <style>
    .section-padding { padding: 4.5rem 0; }
    .video-gallery-section { background: var(--bg-surface); }
    .photo-gallery-section { background: var(--bg-slate); }

    /* Video Grid 2x2 */
    .video-grid-2x2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      margin-top: 2.5rem;
    }
    .video-card {
      padding: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border-top: 4px solid var(--accent-gold);
    }
    .video-container {
      background: #000000;
      width: 100%;
      position: relative;
    }
    .responsive-video-player {
      width: 100%;
      height: 320px;
      object-fit: cover;
      display: block;
    }
    .video-card-body {
      padding: 1.5rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .video-badge {
      color: var(--accent-green);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 1px;
      margin-bottom: 0.4rem;
    }
    .video-card-title {
      font-size: 1.2rem;
      color: var(--primary-navy);
      margin-bottom: 0.6rem;
      line-height: 1.35;
    }
    .video-card-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Albums Container */
    .albums-container { display: flex; flex-direction: column; gap: 2.5rem; margin-top: 2.5rem; }
    .album-block { padding: 2rem; }
    .album-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1.25rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-light);
    }
    .album-cat-tag {
      color: var(--accent-amber);
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: block;
      margin-bottom: 0.2rem;
    }
    .album-title { font-size: 1.4rem; color: var(--primary-navy); }
    .album-count-badge {
      background: var(--bg-slate);
      color: var(--primary-navy);
      font-weight: 700;
      font-size: 0.82rem;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-light);
    }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.25rem;
    }

    .photo-card {
      position: relative;
      border-radius: var(--radius-md);
      overflow: hidden;
      height: 220px;
      cursor: pointer;
      background: var(--primary-navy-dark);
    }
    .gallery-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .photo-card:hover .gallery-img {
      transform: scale(1.08);
    }

    .photo-overlay {
      position: absolute;
      inset: 0;
      background: rgba(10, 25, 47, 0.85);
      opacity: 0;
      transition: opacity 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 1rem;
      text-align: center;
      color: #ffffff;
    }
    .photo-card:hover .photo-overlay {
      opacity: 1;
    }
    .photo-zoom-icon { color: var(--accent-gold); margin-bottom: 0.5rem; }
    .photo-caption-text { font-size: 0.85rem; font-weight: 600; line-height: 1.4; }

    /* Lightbox Modal */
    .lightbox-modal {
      display: none;
      position: fixed;
      z-index: 9999;
      padding-top: 60px;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(10, 25, 47, 0.95);
      backdrop-filter: blur(8px);
    }
    .lightbox-content {
      margin: auto;
      display: block;
      max-width: 90%;
      max-height: 80vh;
      border-radius: var(--radius-md);
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }
    .lightbox-caption {
      margin: 1.25rem auto;
      display: block;
      width: 80%;
      text-align: center;
      color: var(--text-light);
      font-size: 1.1rem;
      font-weight: 600;
    }
    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 35px;
      color: #ffffff;
      font-size: 40px;
      font-weight: bold;
      cursor: pointer;
      transition: color 0.2s;
    }
    .lightbox-close:hover { color: var(--accent-gold); }

    @media (max-width: 900px) {
      .video-grid-2x2 { grid-template-columns: 1fr; }
      .responsive-video-player { height: 260px; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('gallery-lightbox');
      const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const modalCaption = document.getElementById('lightbox-caption');
      const closeBtn = document.querySelector('.lightbox-close');

      document.querySelectorAll('.photo-card').forEach(card => {
        card.addEventListener('click', () => {
          const fullSrc = card.getAttribute('data-full-src');
          const caption = card.getAttribute('data-caption');
          if (modal && modalImg && fullSrc) {
            modal.style.display = 'block';
            modalImg.src = fullSrc;
            if (modalCaption) modalCaption.textContent = caption || '';
          }
        });
      });

      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => {
          modal.style.display = 'none';
        });
      }
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.style.display = 'none';
          }
        });
      }
    });
  </script>
</Layout>
