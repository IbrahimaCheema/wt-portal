---
import Layout from '../../layouts/Layout.astro';
import { getMediaUrl } from '../../utils/media';
---

<Layout title="Interview of CEO Mr Hasan Shahid by Ms Alex Diaz | Western Traders News" activePage="news">
  <!-- Top Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>&rsaquo;</span> <a href="/news/">News & Events</a> <span>&rsaquo;</span> <span class="current">CEO Interview</span>
      </div>
      <h1 class="hero_page_title">Interview of CEO Mr. Hasan Shahid by Ms. Alex Diaz</h1>
      <div class="article-meta-banner">
        <span class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          January 29, 2025
        </span>
        <span class="meta-sep">&bull;</span>
        <span class="meta-item">Category: Corporate & Executive Leadership</span>
      </div>
    </div>
  </section>

  <!-- Article Detail & Embedded Video Section -->
  <section class="section-padding article-detail-section">
    <div class="container">
      <div class="article-container card">
        <p class="lead-paragraph">
          A recent interview that our CEO <strong>Mr. Hasan Shahid</strong> gave to <strong>Ms. Alex Diaz</strong>. She is working on a comprehensive global white paper and has interviewed top executives and market leaders from all over the globe in the field of textile sourcing, yarn indenting, and corporate manufacturing.
        </p>

        <!-- Embedded Video Player Box -->
        <div class="video-embed-box">
          <div class="video-header-bar">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            <span>VIDEO RECORDING &bull; EXECUTIVE INTERVIEW</span>
          </div>

          <div class="video-wrapper">
            <video
              controls
              preload="metadata"
              poster={getMediaUrl("/images/news_interview.png")}
              class="featured-video-player"
            >
              <source src={getMediaUrl("/videos/ceo_interview.mp4")} type="video/mp4" />
              Your browser does not support HTML5 video playback.
            </video>
          </div>
          <div class="video-caption">
            <p><strong>Executive Discussion:</strong> CEO Mr. Hasan Shahid shares insights on Pakistan's textile market positioning, international collaborations, quality control, and future supply chain dynamics.</p>
          </div>
        </div>

        <div class="article-content-body">
          <h3>Key Discussion Highlights</h3>
          <ul class="highlights-list">
            <li><strong>Global Textile Sourcing Dynamics:</strong> Key trends shaping cross-border cotton, yarn, and fabric indenting.</li>
            <li><strong>Quality Assurance & Integrity:</strong> Western Traders' commitment to 100% inspection and contract fulfillment.</li>
            <li><strong>Strategic Partnerships:</strong> Collaborations with premier international spinners such as Intercot (Spain) and QST (USA).</li>
          </ul>

          <div class="article-navigation-bar">
            <a href="/news/" class="btn btn-secondary">
              &larr; Back to News & Events
            </a>
            <a href="/contact/" class="btn btn-primary">
              Contact Executive Office
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .section-padding { padding: 4.5rem 0; }
    .article-detail-section { background: var(--bg-slate); }
    
    .article-container {
      padding: 3rem;
      max-width: 960px;
      margin: 0 auto;
    }
    
    .article-meta-banner {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      color: var(--accent-gold);
      font-size: 0.95rem;
      margin-top: 0.8rem;
    }
    .meta-item { display: flex; align-items: center; gap: 0.4rem; }

    .lead-paragraph {
      font-size: 1.15rem;
      color: var(--primary-navy);
      line-height: 1.7;
      margin-bottom: 2.5rem;
      font-weight: 500;
    }

    /* Video Embed Container */
    .video-embed-box {
      background: var(--primary-navy-dark);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(0,0,0,0.3);
      border: 1px solid rgba(162, 214, 41, 0.3);
      margin-bottom: 2.5rem;
    }
    .video-header-bar {
      padding: 0.9rem 1.25rem;
      background: rgba(255, 255, 255, 0.05);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--accent-green);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .video-wrapper {
      position: relative;
      width: 100%;
      background: #000000;
    }
    .featured-video-player {
      width: 100%;
      height: auto;
      max-height: 540px;
      display: block;
    }
    .video-caption {
      padding: 1rem 1.25rem;
      background: rgba(0, 0, 0, 0.4);
      color: var(--text-light);
      font-size: 0.9rem;
    }
    .video-caption p { margin: 0; }

    /* Content Body */
    .article-content-body h3 {
      font-size: 1.4rem;
      color: var(--primary-navy);
      margin-bottom: 1rem;
    }
    .highlights-list {
      margin: 0 0 2.5rem 1.25rem;
      color: var(--text-muted);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      font-size: 0.98rem;
    }
    .highlights-list li::marker {
      color: var(--accent-gold);
    }

    .article-navigation-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border-light);
      flex-wrap: wrap;
    }

    @media (max-width: 640px) {
      .article-container { padding: 1.5rem; }
    }
  </style>
</Layout>
