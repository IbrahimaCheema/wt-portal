---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Western Traders" activePage="contact">
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>&rsaquo;</span> <span class="current">Contact Us</span>
      </div>
      <h1 class="hero_page_title">Contact Western Traders</h1>
      <p class="hero_subtitle">
        Get in touch with our corporate team for yarn indenting, raw material sourcing, or international trade inquiries.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <div class="grid-2-col">
        <!-- Contact Information Card -->
        <div class="card contact-info-card">
          <h2>Head Office Address</h2>
          <div class="contact-detail-group">
            <div class="detail-item">
              <strong>Office Location:</strong>
              <p>City Tower, Block K, Gulberg 2, Lahore, Pakistan</p>
            </div>
            <div class="detail-item">
              <strong>Phone Lines:</strong>
              <p><a href="tel:+924235770064">+92 42 3577 0064</a> / <a href="tel:+924235770240">+92 42 3577 0240</a></p>
            </div>
            <div class="detail-item">
              <strong>Email Address:</strong>
              <p><a href="mailto:info@western.com.pk">info@western.com.pk</a></p>
            </div>
            <div class="detail-item">
              <strong>Business Hours:</strong>
              <p>Monday – Saturday: 9:00 AM to 7:00 PM</p>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="card contact-form-card" id="callback">
          <h2>Send Us an Inquiry</h2>
          <form id="contactForm" class="contact-form">
            <div class="form-group">
              <label for="cName">Full Name *</label>
              <input type="text" id="cName" required placeholder="Your Name" class="form-control" />
            </div>
            <div class="form-group">
              <label for="cEmail">Email Address *</label>
              <input type="email" id="cEmail" required placeholder="name@company.com" class="form-control" />
            </div>
            <div class="form-group">
              <label for="cPhone">Phone Number *</label>
              <input type="tel" id="cPhone" required placeholder="+92 300 0000000" class="form-control" />
            </div>
            <div class="form-group">
              <label for="cMessage">Inquiry Details *</label>
              <textarea id="cMessage" rows="4" required placeholder="Describe your yarn, fiber, or indenting requirements..." class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-primary submit-btn">
              Submit Corporate Inquiry
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Map Section -->
  <section class="map-section">
    <iframe
      src="https://maps.google.com/maps?q=City%20Tower,%20Block%20K%20Gulberg%202,%20Lahore,%20Pakistan&t=&z=16&ie=UTF8&iwloc=&output=embed"
      width="100%"
      height="400"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      title="Western Traders Office Location"
    ></iframe>
  </section>

  <style>
    .section-padding { padding: 5rem 0; }
    .grid-2-col { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
    .contact-info-card h2, .contact-form-card h2 { color: var(--primary-navy); margin-bottom: 1.5rem; }
    .contact-detail-group { display: flex; flex-direction: column; gap: 1.2rem; }
    .detail-item strong { display: block; font-family: var(--font-heading); font-size: 0.9rem; color: var(--accent-gold); margin-bottom: 0.2rem; }
    .detail-item p { color: var(--text-muted); font-size: 1rem; margin: 0; }
    .contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
    .form-group label { font-family: var(--font-heading); font-size: 0.88rem; font-weight: 600; color: var(--primary-navy); }
    .form-control { width: 100%; padding: 0.8rem 1rem; font-family: var(--font-body); font-size: 0.95rem; border: 1px solid var(--border-light); border-radius: var(--radius-sm); outline: none; }
    .form-control:focus { border-color: var(--accent-gold); }
    .submit-btn { width: 100%; margin-top: 0.5rem; }
    .map-section iframe { display: block; filter: grayscale(10%); }
    @media (max-width: 768px) { .grid-2-col { grid-template-columns: 1fr; } }
  </style>

  <script>
    const contactForm = document.getElementById('contactForm');
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('cName') as HTMLInputElement;
        const name = nameInput?.value || 'Valued Client';
        if (window.showToast) {
          window.showToast(`Thank you, ${name}! Your corporate inquiry has been submitted. We will contact you shortly.`);
        }
        contactForm.reset();
      });
    }
  </script>
</Layout>
