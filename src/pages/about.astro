---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout title="About Us | Western Traders" activePage="about">
  <!-- Top Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>&rsaquo;</span> <span class="current">About Us</span>
      </div>
      <h1 class="hero_page_title">About Us</h1>
      <p class="hero_subtitle">
        The Western Group is a well-established textile trading, indenting, import, and export house comprising several specialized corporate entities.
      </p>
    </div>
  </section>

  <!-- Company Overview & What We Do Section -->
  <section class="section-padding about-main-section">
    <div class="container">
      <div class="grid-2-col">
        <!-- Col 1: About the Company -->
        <div class="card about-content-card">
          <div class="card-img-wrapper">
            <img src={getMediaUrl("/images/company.png")} alt="About Western Traders Company" width="700" height="447" class="card-feature-img" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
          </div>
          <h2 class="card-title">About the Company</h2>
          <p class="body-text">
            The Western group is a well-established textile trading, indenting, import and export house comprising of several specialized legal entities:
          </p>
          <ol class="entities-list">
            <li><strong>Western Traders</strong></li>
            <li><strong>Western Polycot Textiles</strong></li>
            <li><strong>Western Enterprises</strong></li>
          </ol>
          <p class="body-text">
            The CEO of the company, <strong>Mr. Hasan Shahid</strong>, has absolute authority and total control in decision making, strategy, policy formulation, as well as implementation.
          </p>
          <p class="body-text">
            Western is a family-owned setup and our activities are divided into different legal entities, which were created on the basis of serving as a middleman for easy trading of cotton products. Each family member holds a specific share in the company in order to spread volumetric business over different firms.
          </p>
        </div>

        <!-- Col 2: What We Do -->
        <div class="card about-content-card">
          <div class="card-img-wrapper">
            <img src="/images/about_new.jpg" alt="What We Do - Western Traders" width="695" height="447" class="card-feature-img" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
          </div>
          <h2 class="card-title">What We Do</h2>
          <p class="body-text">
            Our basic and most prominent services include indenting, trading and cross-border trade. Specifically, we have expertise in sourcing from reliable vendors, playing a major role in exclusive product developments and R&D, providing inspection services, and ensuring quality products are shipped to the end customer. We keep our commitments even if we have to go through sleepless nights.
          </p>

          <h3 class="sub-title">Products We Offer</h3>
          <p class="body-text">We sell a wide array of varieties to our worthy customers which include:</p>
          <ul class="products-bullet-list">
            <li>Yarns (Cotton, Compact, Open End & Synthetic Counts)</li>
            <li>Fabrics (Denim, Greige & Finished Goods)</li>
            <li>Specialty items</li>
            <li>Garment-related accessories (Waistbands, Elastics, Pocketing)</li>
          </ul>
          <p class="small-text">
            For more details in this regard, please refer to our <a href="/products-and-services/" class="accent-link">Products and Services</a> section.
          </p>

          <h3 class="sub-title">After Sales Service</h3>
          <p class="body-text">
            We believe in long-term partnerships and collaborations rather than one-off trades. We only work with carefully selected buyers and sellers. We deliver and fulfill our contracts and promises regardless of price changes and expect our customers to also honor their commitments.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Leadership Team Section -->
  <section class="section-padding team-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">CORPORATE LEADERSHIP</span>
        <h2 class="section-title">Our Team</h2>
        <p class="section-subtitle">Meet the visionary leaders guiding Western Traders toward international excellence and growth.</p>
      </div>

      <div class="grid-2-col">
        <!-- Team Member 1: CEO -->
        <div class="card team-card">
          <div class="team-member-grid">
            <div class="team-photo-wrapper">
              <img src={getMediaUrl("/images/ceo.jpg")} alt="Mr. Hasan Shahid - CEO Western Traders" width="750" height="945" class="team-photo" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
            </div>
            <div class="team-member-info">
              <h3 class="member-name">Mr. Hasan Shahid</h3>
              <span class="member-role">Chief Executive Officer (CEO)</span>
              <p class="member-bio">
                The CEO of the company Mr. Hasan Shahid, has absolute authority and total control in decision making, strategy, policy formulation, as well as executive implementation.
              </p>
              <div class="member-socials">
                <a href="https://www.facebook.com/hasan.shahid.7731" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
                <a href="https://www.linkedin.com/in/hasan-shahid-81b273182/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Team Member 2: Director -->
        <div class="card team-card">
          <div class="team-member-info-full">
            <h3 class="member-name">Mr. Ibrahim Shahid</h3>
            <span class="member-role">Director</span>
            <p class="member-bio">
              Serving as the Director of Western Traders, our esteemed leader holds an education from Aitchison College and is presently enrolled in the prestigious Warwick Business School.
            </p>
            <p class="member-bio">
              With a strategic mindset and a commitment to excellence, the director leverages a global perspective to guide Western Traders towards ongoing success and innovation in the textile industry. With a solid foundation in accounting principles and the art of economics, our director ensures meticulous financial oversight, insightful market analysis, and strategic decision-making.
            </p>
            <div class="member-socials">
              <a href="https://www.linkedin.com/in/ibrahim-shahid-269428226/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .section-padding { padding: 4.5rem 0; }
    .grid-2-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
    
    .about-content-card {
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
    }
    .card-img-wrapper {
      width: 100%;
      height: 240px;
      border-radius: var(--radius-md);
      overflow: hidden;
      margin-bottom: 1.5rem;
      background: var(--bg-slate);
    }
    .card-feature-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .card-title {
      font-size: 1.6rem;
      color: var(--primary-navy);
      margin-bottom: 1rem;
      position: relative;
      padding-bottom: 0.5rem;
    }
    .card-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 40px;
      height: 3px;
      background: var(--accent-gold);
      border-radius: var(--radius-full);
    }
    .sub-title {
      font-size: 1.2rem;
      color: var(--primary-navy);
      margin: 1.5rem 0 0.6rem 0;
    }
    .body-text {
      font-size: 0.96rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 1rem;
    }
    .small-text {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }
    .accent-link {
      color: var(--accent-gold);
      font-weight: 600;
    }
    .accent-link:hover {
      text-decoration: underline;
    }

    .entities-list {
      margin: 0.5rem 0 1.2rem 1.5rem;
      color: var(--primary-navy);
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .products-bullet-list {
      margin: 0.5rem 0 1rem 1.25rem;
      color: var(--text-muted);
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      font-size: 0.95rem;
    }
    .products-bullet-list li::marker {
      color: var(--accent-gold);
    }

    /* Team Section */
    .team-section {
      background: var(--bg-slate);
    }
    .team-card {
      padding: 2rem;
    }
    .team-member-grid {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 1.5rem;
      align-items: start;
    }
    .team-photo-wrapper {
      width: 140px;
      height: 180px;
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }
    .team-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .member-name {
      font-size: 1.3rem;
      color: var(--primary-navy);
      margin-bottom: 0.2rem;
    }
    .member-role {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--accent-gold);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.8rem;
    }
    .member-bio {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1rem;
    }
    .member-socials {
      display: flex;
      gap: 0.8rem;
    }
    .member-socials a {
      width: 34px;
      height: 34px;
      background: var(--bg-slate);
      border: 1px solid var(--border-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary-navy);
      transition: var(--transition-fast);
    }
    .member-socials a:hover {
      background: var(--accent-gold);
      color: var(--primary-navy-dark);
    }

    @media (max-width: 1024px) {
      .grid-2-col { grid-template-columns: 1fr; gap: 2rem; }
    }
    @media (max-width: 568px) {
      .team-member-grid { grid-template-columns: 1fr; text-align: center; }
      .team-photo-wrapper { margin: 0 auto 1rem auto; }
      .member-socials { justify-content: center; }
    }
  </style>
</Layout>
