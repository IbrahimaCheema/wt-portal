---
import Layout from '../layouts/Layout.astro';
import { getMediaUrl } from '../utils/media';
---

<Layout title="Western Traders | Corporate Textile Sourcing, Indenting & Trading" activePage="home">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-container">
      <div class="hero-grid">
        <div class="hero-content">
          <span class="hero-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ESTABLISHED IN 2002
          </span>
          <h1 class="hero-title">
            Trading, Indenting, <span class="gradient-text">Import & Export</span>
          </h1>
          <p class="hero-description">
            The Western Group is a premier sourcing firm engineered to respond to global customers' needs with unmatched professionalism, precision, and market expertise.
          </p>
        </div>

        <div class="hero-image-box">
          <div class="hero-img-frame">
            <img src={getMediaUrl("/images/textile_yarn_hero_banner.png")} alt="Textile Yarn Cones and Spools Sourcing" width="600" height="420" class="hero-yarn-img" />
            <div class="hero-img-badge">
              <span class="badge-title">100% Quality Inspected</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Hotline Contact Strip -->
  <section class="hotline-strip">
    <div class="container hotline-container">
      <div class="hotline-box">
        <div class="hotline-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="hotline-text">
          <span class="hotline-label">Direct Corporate Hotline:</span>
          <a href="tel:+924235770064" class="hotline-number">+92 42 3577 0064 &nbsp;|&nbsp; +92 42 3577 0240</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Profile & Business Entities Section -->
  <section class="section-padding about-section">
    <div class="container">
      <div class="grid-2-col align-center">
        <!-- Left: Text -->
        <div class="about-text-content">
          <span class="section-badge">SINCE 2002</span>
          <h2 class="section-title">Your Trusted Textile Sourcing Partner</h2>
          <p class="lead-text">
            <strong>Consistency in the Future:</strong> We keep our services up to the mark by periodically visiting and maintaining close relationships with global suppliers and buyers.
          </p>
          <p class="body-text">
            We continuously ascertain our clients' evolving needs and adopt a proactive approach, remaining steadfast in front of all global textile and market challenges.
          </p>
          <div class="about-actions">
            <a href="/products-and-services/" class="btn btn-navy">
              View All Services
            </a>
          </div>
        </div>

        <!-- Right: Business Entity Cards -->
        <div class="entities-grid">
          <div class="entity-card">
            <img src={getMediaUrl("/images/wt_entity_logo.png")} alt="Western Traders Logo" width="220" height="90" class="entity-logo" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
            <div class="entity-info">
              <h4>Western Traders (WT)</h4>
              <p>Core Indenting, Textile Yarns, Raw Fibers & Sourcing Management.</p>
            </div>
          </div>

          <div class="entity-card">
            <img src={getMediaUrl("/images/wpt_entity_logo.png")} alt="Western Polytex Logo" width="220" height="90" class="entity-logo" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
            <div class="entity-info">
              <h4>Western Polytex & Trading (WPT)</h4>
              <p>Specialty Synthetic Yarns, Polymers & Technical Textiles Sourcing.</p>
            </div>
          </div>

          <div class="entity-card">
            <img src={getMediaUrl("/images/we_entity_logo.png")} alt="Western Enterprises Logo" width="220" height="90" class="entity-logo" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
            <div class="entity-info">
              <h4>Western Enterprises (WE)</h4>
              <p>Import, Export, Indenting & Global International Trade Logistics.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Animated Counter Stats Section -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-header">
        <h2 class="stats-main-title">Streamlined and Standardized Operations</h2>
        <p class="stats-sub-title">Fostering long-term corporate relationships with top-tier textile manufacturers worldwide.</p>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">20+</div>
          <div class="stat-label">Years of Excellence</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">3+</div>
          <div class="stat-label">Global Collaborations</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">200+</div>
          <div class="stat-label">Happy Corporate Clients</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">100%</div>
          <div class="stat-label">Quality & Delivery Assurance</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Collaborations & Global Experience Section -->
  <section class="section-padding collaborations-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">AUTHORIZED REPRESENTATION</span>
        <h2 class="section-title">Collaborations and Experiences</h2>
        <p class="section-subtitle">
          We are the authorized agents of several prestigious international companies and have served them efficiently over the years.
        </p>
      </div>

      <div class="grid-3-col">
        <!-- Card 1: Intercot -->
        <div class="card collaboration-card">
          <div class="collab-img-wrapper">
            <img src={getMediaUrl("/images/intercot_logo.jpg")} alt="Intercot S.A." width="300" height="150" class="collab-img" onerror="this.onerror=null; this.src='/images/cert_1.png'" />
          </div>
          <div class="collab-body">
            <h3 class="collab-name">Intercot, S.A.</h3>
            <p class="collab-desc">
              INTERCOT, S.A. is a premium spinning mill founded in 1986, specialized in the production of thick, bulky Open End yarns in 100% Cotton, 100% Linen, and Cotton blends.
            </p>
            <a href="/collaborations/#intercot" class="collab-link">Read Full Details &rarr;</a>
          </div>
        </div>

        <!-- Card 2: Naveena -->
        <div class="card collaboration-card">
          <div class="collab-img-wrapper">
            <img src={getMediaUrl("/images/naveena_logo.jpg")} alt="Naveena Industries" width="300" height="150" class="collab-img" onerror="this.onerror=null; this.src='/images/cert_2.png'" />
          </div>
          <div class="collab-body">
            <h3 class="collab-name">Naveena Industries</h3>
            <p class="collab-desc">
              Based in Pakistan, NAVEENA produces high-grade yarn and fabric, providing full-package solutions to traders, importers, and major global fashion brands since 1967.
            </p>
            <a href="/collaborations/#naveena" class="collab-link">Read Full Details &rarr;</a>
          </div>
        </div>

        <!-- Card 3: QST -->
        <div class="card collaboration-card">
          <div class="collab-img-wrapper">
            <img src={getMediaUrl("/images/qst_logo.png")} alt="QST Industries" width="300" height="150" class="collab-img" onerror="this.onerror=null; this.src='/images/cert_3.png'" />
          </div>
          <div class="collab-body">
            <h3 class="collab-name">QST Industries</h3>
            <p class="collab-desc">
              QST is a global family-owned industry dating back to 1880, leading the market in textile waistbands, elastics, pocketing, interlinings, and garment construction.
            </p>
            <a href="/collaborations/#qst" class="collab-link">Read Full Details &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications Grid -->
  <section class="section-padding certs-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">STANDARDS & ACCREDITATIONS</span>
        <h2 class="section-title">Certified Excellence</h2>
      </div>
      <div class="certs-grid">
        <div class="cert-card"><img src={getMediaUrl("/images/cert_1.png")} alt="Certification 1" width="180" height="90" /></div>
        <div class="cert-card"><img src={getMediaUrl("/images/cert_2.png")} alt="Certification 2" width="180" height="90" /></div>
        <div class="cert-card"><img src={getMediaUrl("/images/cert_3.png")} alt="Certification 3" width="180" height="90" /></div>
        <div class="cert-card"><img src={getMediaUrl("/images/cert_4.png")} alt="Certification 4" width="180" height="90" /></div>
      </div>
    </div>
  </section>



  <!-- Interactive Map Section -->
  <section class="map-section">
    <iframe
      src="https://maps.google.com/maps?q=City%20Tower,%20Block%20K%20Gulberg%202,%20Lahore,%20Pakistan&t=&z=16&ie=UTF8&iwloc=&output=embed"
      width="100%"
      height="380"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      title="Western Traders Head Office Location"
    ></iframe>
  </section>

  <style>
    /* Section Padding Standard */
    .section-padding {
      padding: 5rem 0;
    }

    /* Hero Section */
    .hero-section {
      background: linear-gradient(135deg, var(--primary-navy-dark) 0%, var(--primary-navy) 60%, #1e293b 100%);
      color: var(--text-white);
      padding: 3.2rem 0 3.5rem 0;
      position: relative;
      overflow: hidden;
      border-bottom: 4px solid var(--accent-gold);
    }
    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at top right, rgba(162, 214, 41, 0.12) 0%, transparent 60%);
      pointer-events: none;
    }
    .hero-container {
      position: relative;
      z-index: 2;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2.5rem;
      align-items: center;
    }
    .hero-content {
      max-width: 720px;
    }
    .hero-image-box {
      display: flex;
      justify-content: center;
    }
    .hero-img-frame {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4), 0 0 0 2px rgba(162, 214, 41, 0.3);
      border: 3px solid rgba(255, 255, 255, 0.1);
      transition: var(--transition-normal);
    }
    .hero-img-frame:hover {
      transform: scale(1.02);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(162, 214, 41, 0.4);
    }
    .hero-yarn-img {
      width: 100%;
      height: 280px;
      object-fit: cover;
      display: block;
    }
    .hero-img-badge {
      position: absolute;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(10, 25, 47, 0.45);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(162, 214, 41, 0.4);
      padding: 0.5rem 1.25rem;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
    }
    .badge-title {
      font-family: var(--font-heading);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--accent-green);
    }
    .badge-sub {
      font-size: 0.82rem;
      color: var(--text-light);
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 1rem;
      background: rgba(217, 119, 6, 0.18);
      border: 1px solid rgba(217, 119, 6, 0.4);
      color: var(--accent-amber);
      font-family: var(--font-heading);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 1.2px;
      border-radius: var(--radius-full);
      margin-bottom: 1.5rem;
    }
    .hero-title {
      color: var(--text-white);
      margin-bottom: 1.2rem;
      letter-spacing: -0.5px;
    }
    .gradient-text {
      background: linear-gradient(135deg, var(--accent-amber) 0%, var(--accent-gold) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-description {
      font-size: 1.15rem;
      line-height: 1.7;
      color: var(--text-light);
      margin-bottom: 0;
    }
    .hero-buttons {
      display: flex;
      gap: 1.2rem;
      flex-wrap: wrap;
    }

    /* Hotline Strip */
    .hotline-strip {
      background: var(--accent-gold);
      color: var(--primary-navy-dark);
      padding: 1.2rem 0;
      box-shadow: var(--shadow-md);
    }
    .hotline-container {
      display: flex;
      justify-content: center;
    }
    .hotline-box {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .hotline-icon {
      width: 48px;
      height: 48px;
      background: rgba(10, 25, 47, 0.12);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary-navy-dark);
    }
    .hotline-text {
      display: flex;
      flex-direction: column;
    }
    .hotline-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
      color: var(--primary-navy);
    }
    .hotline-number {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--primary-navy-dark);
    }
    .hotline-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
      opacity: 0.9;
    }
    .hotline-number {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-white);
    }

    /* Grid Layouts */
    .grid-2-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
    .grid-3-col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .align-center {
      align-items: center;
    }

    /* About Section & Entity Cards */
    .about-section {
      background: var(--bg-surface);
    }
    .lead-text {
      font-size: 1.15rem;
      color: var(--primary-navy);
      line-height: 1.7;
      margin-bottom: 1rem;
    }
    .body-text {
      color: var(--text-muted);
      margin-bottom: 2rem;
    }
    .entities-grid {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .entity-card {
      background: var(--bg-slate);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      transition: var(--transition-fast);
    }
    .entity-card:hover {
      border-color: var(--accent-gold);
      transform: translateX(6px);
      box-shadow: var(--shadow-md);
    }
    .entity-logo {
      height: 60px;
      width: auto;
      object-fit: contain;
    }
    .entity-info h4 {
      font-size: 1.05rem;
      color: var(--primary-navy);
      margin-bottom: 0.25rem;
    }
    .entity-info p {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin: 0;
    }

    /* Stats Section */
    .stats-section {
      background: linear-gradient(135deg, var(--primary-navy-dark) 0%, var(--primary-navy) 100%);
      color: var(--text-white);
      padding: 2.8rem 0;
    }
    .stats-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 1.8rem auto;
    }
    .stats-main-title {
      color: var(--text-white);
      margin-bottom: 0.4rem;
    }
    .stats-sub-title {
      color: var(--text-light);
      font-size: 0.98rem;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    .stat-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      padding: 1.4rem 1rem;
      text-align: center;
      transition: var(--transition-fast);
    }
    .stat-card:hover {
      border-color: var(--accent-gold);
      background: rgba(255, 255, 255, 0.08);
      transform: translateY(-3px);
    }
    .stat-number {
      font-family: var(--font-heading);
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--accent-amber);
      margin-bottom: 0.25rem;
      line-height: 1.1;
    }
    .stat-label {
      font-size: 0.88rem;
      color: #cbd5e1;
      font-weight: 600;
    }

    /* Collaborations Section */
    .collaborations-section {
      background: var(--bg-slate);
    }
    .collaboration-card {
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .collab-img-wrapper {
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-slate);
      border-radius: var(--radius-sm);
      margin-bottom: 1.25rem;
      padding: 1rem;
    }
    .collab-img {
      max-height: 100px;
      width: auto;
      object-fit: contain;
    }
    .collab-name {
      color: var(--primary-navy);
      margin-bottom: 0.8rem;
    }
    .collab-desc {
      font-size: 0.92rem;
      color: var(--text-muted);
      flex-grow: 1;
      margin-bottom: 1.2rem;
    }
    .collab-link {
      font-family: var(--font-heading);
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--accent-gold);
    }
    .collab-link:hover {
      color: var(--accent-gold-hover);
    }

    /* Certifications Grid */
    .certs-section {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-light);
    }
    .certs-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      align-items: center;
    }
    .cert-card {
      background: var(--bg-slate);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-fast);
    }
    .cert-card:hover {
      border-color: var(--accent-gold);
      transform: scale(1.04);
    }
    .cert-card img {
      max-height: 70px;
      width: auto;
      object-fit: contain;
    }

    /* Callback Form Section */
    .callback-section {
      background: var(--bg-slate);
    }
    .callback-subtitle {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }
    .callback-contact-items {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .cb-item {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      color: var(--primary-navy);
    }
    .cb-item svg {
      color: var(--accent-gold);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .callback-card {
      background: var(--bg-surface);
      box-shadow: var(--shadow-lg);
    }
    .callback-form {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-group label {
      font-family: var(--font-heading);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--primary-navy);
    }
    .form-control {
      width: 100%;
      padding: 0.8rem 1rem;
      font-family: var(--font-body);
      font-size: 0.95rem;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      outline: none;
      transition: var(--transition-fast);
    }
    .form-control:focus {
      border-color: var(--accent-gold);
      box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.15);
    }
    .submit-btn {
      width: 100%;
      margin-top: 0.5rem;
    }

    /* Map Section */
    .map-section iframe {
      display: block;
      filter: grayscale(10%);
    }

    /* Responsive Breakpoints */
    @media (max-width: 1024px) {
      .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; text-align: center; }
      .hero-content { max-width: 100%; margin: 0 auto; }
      .hero-buttons { justify-content: center; }
      .grid-2-col, .grid-3-col { grid-template-columns: 1fr; gap: 2.5rem; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .certs-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .hero-section { padding: 4.5rem 0 5rem 0; }
      .stats-grid { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      .hotline-box { flex-direction: column; text-align: center; }
      .entity-card { flex-direction: column; text-align: center; }
    }
  </style>

  <script>
    const form = document.getElementById('callbackForm');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const firstNameInput = document.getElementById('firstName') as HTMLInputElement;
        const name = firstNameInput?.value || 'Valued Client';
        
        if (window.showToast) {
          window.showToast(`Thank you, ${name}! Your callback request has been received. Our corporate team will contact you shortly.`);
        }
        form.reset();
      });
    }
  </script>
</Layout>
