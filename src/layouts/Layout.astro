---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getMediaUrl } from '../utils/media';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = "Western Traders | Global Textile Sourcing, Indenting & Trading",
  description = "Western Traders - Established in 2002. Leading corporate sourcing firm for textile yarns, fibers, fabrics, denim, and apparel accessories with global collaborations.",
  activePage = "home"
} = Astro.props;

const faviconUrl = getMediaUrl("/images/favicon-32.png");
const ogImageUrl = getMediaUrl("/images/wt_header_logo.png");
---

<!html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header activePage={activePage} />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Toast Alert Container -->
    <div id="toastContainer" class="toast-container"></div>

    <script>
      // Global Toast Notification Helper
      window.showToast = function(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>${message}</span>
        `;
        container.appendChild(toast);
        setTimeout(() => {
          toast.remove();
        }, 4000);
      };
    </script>
  </body>
</html>
