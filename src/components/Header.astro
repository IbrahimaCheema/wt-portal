---
import { getMediaUrl } from '../utils/media';

interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;

const logoUrl = getMediaUrl("/images/wt_header_logo.png");
---

<!-- Top Contact & Info Bar -->
<div class="top-bar">
  <div class="container top-bar-container">
    <div class="top-info">
      <a href="tel:+924235770064" class="info-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>+92 42 3577 0064 / 0240</span>
      </a>
      <a href="mailto:info@western.com.pk" class="info-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <span>info@western.com.pk</span>
      </a>
      <div class="info-item hide-on-mobile">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Mon - Sat: 9:00 AM - 7:00 PM</span>
      </div>
    </div>

    <div class="top-socials">
      <a href="https://www.instagram.com/western.builders/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a href="https://www.facebook.com/westerngroups503" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Navigation -->
<header class="main-header" id="mainHeader">
  <div class="container header-container">
    <a href="/" class="brand-logo">
      <img src={logoUrl} alt="Western Traders" width="180" height="60" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
    </a>

    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li class={activePage === 'home' ? 'active' : ''}>
          <a href="/">Home</a>
        </li>
        <li class={`has-dropdown ${['about', 'collaborations', 'vision'].includes(activePage) ? 'active' : ''}`}>
          <a href="/about/">
            About
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/about/">Our Company</a></li>
            <li><a href="/collaborations/">Collaborations</a></li>
            <li><a href="/vision-and-mission/">Vision & Mission</a></li>
          </ul>
        </li>
        <li class={activePage === 'products' ? 'active' : ''}>
          <a href="/products-and-services/">Products & Services</a>
        </li>
        <li class={activePage === 'news' ? 'active' : ''}>
          <a href="/news/">News & Events</a>
        </li>
        <li class={activePage === 'gallery' ? 'active' : ''}>
          <a href="/gallery/">Gallery</a>
        </li>
        <li class={activePage === 'contact' ? 'active' : ''}>
          <a href="/contact/">Contact</a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle Navigation Menu">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <ul class="mobile-nav-list">
      <li><a href="/">Home</a></li>
      <li><a href="/about/">Our Company</a></li>
      <li><a href="/collaborations/">Collaborations</a></li>
      <li><a href="/vision-and-mission/">Vision & Mission</a></li>
      <li><a href="/products-and-services/">Products & Services</a></li>
      <li><a href="/news/">News & Events</a></li>
      <li><a href="/gallery/">Gallery</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </div>
</header>

<style>
  /* Top Bar */
  .top-bar {
    background: var(--primary-navy-dark);
    color: var(--text-light);
    font-size: 0.85rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .top-bar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .top-info {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  .info-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #cbd5e1;
  }
  .info-item:hover {
    color: var(--accent-amber);
  }
  .top-socials {
    display: flex;
    gap: 1rem;
  }
  .top-socials a {
    color: #cbd5e1;
  }
  .top-socials a:hover {
    color: var(--accent-amber);
  }

  /* Main Header */
  .main-header {
    background: var(--bg-surface);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: var(--shadow-md);
    transition: var(--transition-normal);
  }
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .brand-logo img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  /* Nav Links */
  .desktop-nav .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-list > li > a {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--primary-navy);
    padding: 0.5rem 0;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-list > li > a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 3px;
    background: var(--accent-gold);
    transition: var(--transition-fast);
    border-radius: var(--radius-full);
  }
  .nav-list > li:hover > a,
  .nav-list > li.active > a {
    color: var(--accent-gold);
  }
  .nav-list > li:hover > a::after,
  .nav-list > li.active > a::after {
    width: 100%;
  }

  /* Dropdown Menu */
  .has-dropdown {
    position: relative;
  }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 200px;
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: var(--transition-fast);
  }
  .has-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown-menu a {
    display: block;
    padding: 0.6rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-main);
  }
  .dropdown-menu a:hover {
    background: var(--bg-slate);
    color: var(--accent-gold);
  }

  /* Header CTA */
  .btn-header-cta {
    padding: 0.65rem 1.25rem;
    font-size: 0.85rem;
  }

  /* Mobile Toggle & Drawer */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  .hamburger-bar {
    width: 24px;
    height: 3px;
    background: var(--primary-navy);
    border-radius: 2px;
    transition: var(--transition-fast);
  }
  .mobile-drawer {
    display: none;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-light);
    padding: 1.5rem;
    box-shadow: var(--shadow-xl);
  }
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .mobile-nav-list a {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary-navy);
  }

  @media (max-width: 1024px) {
    .desktop-nav { display: none; }
    .mobile-toggle { display: flex; }
    .hide-on-mobile { display: none !important; }
    .mobile-drawer.open { display: block; }
  }
</style>

<script>
  const mobileToggle = document.getElementById('mobileToggle');
  const mobileDrawer = document.getElementById('mobileDrawer');
  
  if (mobileToggle && mobileDrawer) {
    mobileToggle.addEventListener('click', () => {
      mobileDrawer.classList.toggle('open');
    });
  }
</script>
