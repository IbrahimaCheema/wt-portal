---
import { getMediaUrl } from '../utils/media';

const footerLogoUrl = getMediaUrl("/images/wt_header_logo.png");
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Bio & Branding -->
      <div class="footer-col footer-col-bio">
        <a href="/" class="footer-logo">
          <img src={footerLogoUrl} alt="Western Traders" width="180" height="60" onerror="this.onerror=null; this.src='/images/wt_header_logo.png'" />
        </a>
        <p class="footer-bio-text">
          A premier corporate sourcing firm incorporated in 2002, engineered to fulfill global textile, yarn, and trading needs with highest standards of professionalism and integrity.
        </p>
        <div class="footer-contact-quick">
          <p><strong>Head Office:</strong> City Tower, Block K, Gulberg 2, Lahore, Pakistan</p>
          <p><strong>Call:</strong> <a href="tel:+924235770064">+92 42 3577 0064</a> | <a href="tel:+924235770240">+92 42 3577 0240</a></p>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h4 class="footer-title">Site Info</h4>
        <ul class="footer-links">
          <li><a href="/vision-and-mission/">Vision & Mission</a></li>
          <li><a href="/products-and-services/">Products & Services</a></li>
          <li><a href="/collaborations/">Global Collaborations</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Col 3: Recent Highlights -->
      <div class="footer-col">
        <h4 class="footer-title">Recent Posts</h4>
        <ul class="footer-posts">
          <li>
            <a href="/news/interview-of-ceo-mr-hasan-shahid-by-ms-alex-diaz/">
              <span class="post-title">Interview of CEO Mr. Hasan Shahid by Ms. Alex Diaz</span>
            </a>
          </li>
          <li>
            <a href="/news/heimtextil-and-intercot-visit-2024/">
              <span class="post-title">Heimtextil and Intercot Visit 2024</span>
            </a>
          </li>
          <li>
            <a href="/news/#qst-lanka">
              <span class="post-title">QST Lanka Visit to Pakistan</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Business Hours -->
      <div class="footer-col">
        <h4 class="footer-title">Business Hours</h4>
        <p class="footer-text-sm">Our corporate sales & support services operate as per the following schedule:</p>
        <div class="hours-card">
          <div class="hours-row">
            <span>Monday – Saturday:</span>
            <strong>9:00 AM – 7:00 PM</strong>
          </div>
          <div class="hours-row">
            <span>Sunday:</span>
            <span class="closed">Closed</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p class="copyright-text">
        Copyright &copy; {currentYear} <strong>Western Traders</strong>. All Rights Reserved.
      </p>
      <div class="footer-socials">
        <a href="https://www.instagram.com/western.builders/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com/westerngroups503" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--primary-navy-dark);
    color: var(--text-light);
    padding-top: 4.5rem;
    padding-bottom: 2rem;
    margin-top: auto;
    border-top: 4px solid var(--accent-gold);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr 1.1fr 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer-logo {
    display: inline-block;
    background: #ffffff;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.2rem;
  }
  .footer-logo img {
    height: 42px;
    width: auto;
    display: block;
  }
  .footer-bio-text {
    font-size: 0.92rem;
    line-height: 1.7;
    color: #94a3b8;
    margin-bottom: 1.2rem;
  }
  .footer-contact-quick {
    font-size: 0.88rem;
    color: #cbd5e1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .footer-contact-quick a {
    color: var(--accent-amber);
  }
  .footer-title {
    color: var(--text-white);
    font-size: 1.1rem;
    margin-bottom: 1.4rem;
    position: relative;
    padding-bottom: 0.5rem;
  }
  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 35px;
    height: 3px;
    background: var(--accent-gold);
    border-radius: var(--radius-full);
  }
  .footer-links, .footer-posts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-links a {
    font-size: 0.92rem;
    color: #cbd5e1;
  }
  .footer-links a:hover {
    color: var(--accent-amber);
    padding-left: 4px;
  }
  .footer-posts li {
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
  }
  .footer-posts li:last-child {
    border-bottom: none;
  }
  .footer-posts a {
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.4;
    display: block;
  }
  .footer-posts a:hover {
    color: var(--accent-amber);
  }
  .footer-text-sm {
    font-size: 0.88rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }
  .hours-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1rem;
    border-radius: var(--radius-md);
  }
  .hours-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    padding: 0.4rem 0;
    color: #e2e8f0;
  }
  .closed {
    color: #f87171;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.88rem;
    color: #94a3b8;
  }
  .footer-socials {
    display: flex;
    gap: 1rem;
  }
  .footer-socials a {
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-white);
    transition: var(--transition-fast);
  }
  .footer-socials a:hover {
    background: var(--accent-gold);
    color: var(--text-white);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
